# --- required -------------------------------------------------------------
# Railway injects this automatically once you add a Postgres database.
DATABASE_URL=postgresql://user:password@localhost:5432/carterlane

# Sign-in for /admin. Use a long random string for SESSION_SECRET.
SESSION_SECRET=change-me-to-32-plus-random-characters
ADMIN_PASSWORD=change-me
# Optional: use a bcrypt hash instead of the plaintext password above. If this
# is set to anything, it takes precedence and ADMIN_PASSWORD is ignored — so
# leave it out entirely unless you mean to use it.
# ADMIN_PASSWORD_HASH=

# --- recommended ----------------------------------------------------------
# Comma-separated list of front-end origins allowed to call this API.
# Leave empty to allow any origin (fine before launch, tighten afterwards).
ALLOWED_ORIGINS=https://carterlane.vercel.app,http://localhost:3000
ALLOW_VERCEL_PREVIEWS=true

# Where new booking requests are emailed.
OWNER_EMAIL=you@example.com

# --- optional -------------------------------------------------------------
PORT=4000
SESSION_TTL=12h

# Abuse limits. The defaults suit a live site; raise BOOKING_RATE_LIMIT when
# running the end-to-end suite, which makes several bookings per run.
BOOKING_RATE_LIMIT=10
BOOKING_RATE_WINDOW_MIN=15
LOGIN_RATE_LIMIT=8
LOGIN_RATE_WINDOW_MIN=10
MAX_UPLOAD_MB=12
PHOTO_MAX_EDGE=2400
PHOTO_QUALITY=82

# SMTP — without these, emails are logged to the Railway console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Carterlane <bookings@example.com>"
