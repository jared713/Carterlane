# The Railway API. Must include https:// — a bare hostname would otherwise be
# read as a path on this site. No trailing slash.
NEXT_PUBLIC_API_URL=https://carterlane-api.up.railway.app

# Used for canonical URLs and social previews.
NEXT_PUBLIC_SITE_URL=https://carterlane.vercel.app

